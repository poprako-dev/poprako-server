# GitHub repository -> Settings -> Environments -> production -> Environment secrets
#
# Add every name below as a separate Environment secret. This file documents
# the shape of the values only. Never replace these placeholders with real
# infrastructure values in the repository.

# SSH endpoint used by the GitHub-hosted runner.
DEPLOY_HOST=<production-server-host-or-ip>
DEPLOY_PORT=22
DEPLOY_USER=<dedicated-deployment-user>

# Paste the complete private key, including the BEGIN/END lines. Use a
# deployment-only key whose public half is authorized for DEPLOY_USER.
DEPLOY_SSH_PRIVATE_KEY=<complete-multiline-openssh-private-key>

# Paste one complete known_hosts line for DEPLOY_HOST. Verify its fingerprint
# out of band before storing it.
DEPLOY_KNOWN_HOSTS=<host ssh-ed25519 public-key>

# Dedicated application directory on the remote host. This is not /root and
# does not mean the root Unix account.
DEPLOY_ROOT=/opt/poprako-server

# The host-side listener used by a reverse proxy. The container always listens
# on port 8888 internally.
DEPLOY_PUBLIC_PORT=18888
DEPLOY_BIND_HOST=127.0.0.1

# Names of the existing production Docker network and PostgreSQL 18 container.
DEPLOY_DOCKER_NETWORK=<production-docker-network>
DEPLOY_POSTGRES_CONTAINER=<existing-postgresql-18-container>

# Paste the complete, production-filled contents represented by .env.example
# as this single multiline secret. Do not enter a path such as `.env` here.
DEPLOY_RUNTIME_ENV=<complete-multiline-runtime-dotenv>
