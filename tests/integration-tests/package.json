{
    "name": "@poprako/integration-tests",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": "26.x",
        "pnpm": "12.11.2"
    },
    "scripts": {
        "api": "vitest run",
        "api:env": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.5",
        "@types/pg": "8.23.1",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1",
        "vitest": "5.0.3"
    },
    "dependencies": {
        "pg": "8.23.1"
    }
}
