# Database config for dev or prod
DATABASE_URL=postgres://devuser:devpassword@localhost:5432/db_poprako_r
POSTGRES_PASSWORD=devpassword

# JWT secret key for authorization
JWT_SECRET_KEY=some_secret_key
JWT_EXPIRATION_HOURS=72

# OSS provider: r2 | aliyun | noop
OSS_PLATFORM=r2

# Cloudflare R2 (used when OSS_PLATFORM=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# R2_REGION=auto          (optional, defaults to auto)
# R2_CUSTOM_DOMAIN=       (optional, required for presigned GET URLs)

# Aliyun OSS (used when OSS_PLATFORM=aliyun)
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_REGION=
# ALIYUN_OSS_BUCKET_NAME=
# ALIYUN_OSS_CUSTOM_DOMAIN=
# ALIYUN_OSS_ENDPOINT=    (optional, defaults to https://oss-{region}.aliyuncs.com)
