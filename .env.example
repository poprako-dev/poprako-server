# Database config for dev or prod
DATABASE_URL=postgres://devuser:devpassword@localhost:5432/db_poprako_server_prod

# JWT secret key for authorization
JWT_SECRET=some_secret_key
JWT_EXPIRATION_HOURS=72

# Cloudflare R2 (required by the active production harness)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# R2_REGION=auto          (optional, defaults to auto)
R2_CUSTOM_DOMAIN=

# Snowflake node ID (optional, defaults to 0; valid range: 0..=1023)
# POPRAKO_SNOWFLAKE_NODE_ID=0
