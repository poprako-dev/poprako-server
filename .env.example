# PostgreSQL connection URL. Percent-encode reserved characters in the password.
# For Docker production, use the PostgreSQL container name as the host because
# both containers run on the same Docker network. Production uses
# db_poprako_server_prod; development and test databases use the db_ prefix too.
DATABASE_URL=postgres://<database-user>:<percent-encoded-database-password>@<database-host>:5432/db_poprako_server_prod

# Generate a production value with: openssl rand -hex 32
JWT_SECRET=<random-hex-secret>
JWT_EXPIRATION_HOURS=72

# Cloudflare R2; every value except R2_REGION is required at startup.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=<production-bucket-name>
R2_REGION=auto
R2_CUSTOM_DOMAIN=<https://assets.example.com>

# Snowflake node ID (optional, defaults to 0; valid range: 0..=1023)
POPRAKO_SNOWFLAKE_NODE_ID=0
